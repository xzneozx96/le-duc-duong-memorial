# Copy to .env and replace every CHANGE_ME. Never commit .env.
# The database and photo store are Neon (Postgres + Object Storage). In a linked repo,
# `npx neon@latest env pull --file .env` fills the Neon variables below.

# Public domain of the site; DNS must point here. Caddy gets the HTTPS certificate for it.
SITE_DOMAIN=memorial.example.org

# Neon Postgres. DATABASE_URL is the pooled URL (app traffic); DATABASE_URL_UNPOOLED is the direct
# URL (migrations at start-up).
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@ep-CHANGE_ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://CHANGE_ME:CHANGE_ME@ep-CHANGE_ME.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible, path-style). S3_BUCKET is the bucket declared in neon.ts.
AWS_ENDPOINT_URL_S3=https://CHANGE_ME
AWS_REGION=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=uploads

# Total stored photo bytes before new uploads are refused.
PHOTO_QUOTA_BYTES=20000000000

# Later, for the admin page (not used yet).
# ADMIN_PASSWORD=CHANGE_ME
