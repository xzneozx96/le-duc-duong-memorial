# Copy to .env and replace every CHANGE_ME. Never commit .env.

# Public domain of the site; DNS must point here. Caddy gets the HTTPS certificate for it.
SITE_DOMAIN=memorial.example.org

# Postgres user, password and database name (the app's DATABASE_URL is built from these in docker-compose.yml).
POSTGRES_USER=memorial
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=memorial

# Only for local runs outside Docker; in Docker compose builds it from the POSTGRES_* values.
# DATABASE_URL=postgres://memorial:CHANGE_ME_long_random@localhost:5432/memorial

# S3 settings for photos (SeaweedFS container). docker-compose.yml sets the endpoint to the s3 container.
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=memorial-photos
# Access keys: the s3 container accepts exactly these, and the app uses them. Choose any long random values.
S3_ACCESS_KEY=CHANGE_ME_app_key
S3_SECRET_KEY=CHANGE_ME_long_random_app_secret
# Path-style URLs (required by SeaweedFS).
S3_FORCE_PATH_STYLE=true

# Total stored photo bytes before new uploads are refused; keep it well under the server's free disk.
PHOTO_QUOTA_BYTES=20000000000

# Later, for the admin page (not used yet).
# ADMIN_PASSWORD=CHANGE_ME
